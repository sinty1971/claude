{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug web-api server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/web-api/cmd/server",
      "env": {},
      "args": []
    },
    {
      "name": "Attach to headless Delve",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345
    },
    {
      "name": "Debug tests (package)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/web-api"
    }
  ]
}
